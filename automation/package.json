{
  "name": "@nylzo/automation",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "lint": "oxfmt --check . && oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix && bun run format",
    "test": "bun test --parallel",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@octokit/plugin-rest-endpoint-methods": "18.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
