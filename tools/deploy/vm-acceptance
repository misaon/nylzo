#!/usr/bin/env bash
set -euo pipefail
trap 'echo "VM acceptance failed at line $LINENO: $BASH_COMMAND" >&2' ERR
umask 077
directory=/var/lib/nylzo-vm-test
mkdir -p "$directory"
[[ "$(getenforce)" = Enforcing ]]
[[ "$(sysctl -n kernel.dmesg_restrict)" = 1 ]]
[[ "$(sysctl -n kernel.kptr_restrict)" = 2 ]]
[[ "$(sysctl -n net.ipv4.conf.all.rp_filter)" = 2 ]]
for check in kernel.kexec_load_disabled=1 kernel.io_uring_disabled=2 kernel.sysrq=0 dev.tty.ldisc_autoload=0 fs.suid_dumpable=0; do
  [[ "$(sysctl -n "${check%%=*}")" = "${check#*=}" ]] || { echo "Kernel setting ${check%%=*} is not hardened." >&2; exit 1; }
done
[[ "$(readlink -e /opt/nylzo/host/current)" = /opt/nylzo/host/initial ]]
[[ "$(systemctl show systemd-sysupdate-reboot.timer --property=LoadState --value)" = masked ]]
sshd -t
ssh_policy=$(sshd -T | tr '[:upper:]' '[:lower:]')
expect() {
  [[ "$(awk -v setting="$1" '$1 == setting { print $2 }' <<< "$ssh_policy")" = "$2" ]] || { echo "sshd $1 is not $2" >&2; exit 1; }
}
expect kexalgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com
expect hostkeyalgorithms ssh-ed25519
expect pubkeyacceptedalgorithms sk-ssh-ed25519@openssh.com,sk-ecdsa-sha2-nistp256@openssh.com
expect pubkeyauthoptions touch-required
expect ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
expect macs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
[[ "$(awk '$1 == "hostkey" { print $2 }' <<< "$ssh_policy")" = /etc/ssh/ssh_host_ed25519_key ]]
echo 'NYLZO_VM_SSH_POLICY_VERIFIED'
nft list chain inet nylzo input | grep --fixed-strings --quiet 'type filter hook input priority filter; policy drop;'
ip netns add nylzo-outside
trap 'ip netns delete nylzo-outside 2>/dev/null || true; ip link delete nylzo-probe 2>/dev/null || true' EXIT
ip link add nylzo-probe type veth peer name nylzo-peer netns nylzo-outside
ip address add 198.51.100.1/24 dev nylzo-probe
ip link set nylzo-probe up
ip -n nylzo-outside address add 198.51.100.2/24 dev nylzo-peer
ip -n nylzo-outside link set nylzo-peer up
ip -n nylzo-outside link set lo up
connect() {
  local status=0
  ip netns exec nylzo-outside curl --silent --output /dev/null --connect-timeout 5 --max-time 10 "http://198.51.100.1:$1/" || status=$?
  echo "$status"
}
[[ "$(connect 22)" = 28 ]] || { echo 'SSH answered a source outside the administrator networks.' >&2; exit 1; }
[[ "$(connect 80)" = 0 ]] || { echo 'HTTP did not answer a public source.' >&2; exit 1; }
ip netns delete nylzo-outside
ip link delete nylzo-probe 2>/dev/null || true
trap - EXIT
echo 'NYLZO_VM_HOST_FIREWALL_VERIFIED'
if [[ -s /etc/nylzo/tang.json ]]; then
  for target in /var/lib/nylzo /var/lib/nylzo-secrets /var/lib/caddy /var/log/journal; do
    [[ "$(findmnt --noheadings --output SOURCE --mountpoint "$target")" = "/dev/mapper/nylzo-storage[/${target##*/}]" ]]
  done
  [[ "$(lsblk --noheadings --output TYPE /dev/mapper/nylzo-storage)" = crypt ]]
  loop=$(losetup --noheadings --output NAME --associated /var/lib/nylzo-storage.luks)
  cryptsetup luksDump "$loop" > "$directory/luks"
  [[ "$(grep --count --extended-regexp '^  [0-9]+: luks2$' "$directory/luks")" = 1 ]]
  grep --quiet --extended-regexp '^  [0-9]+: clevis$' "$directory/luks"
  echo 'NYLZO_VM_ENCRYPTED_STORAGE_VERIFIED'
fi
systemd-analyze cat-config systemd/coredump.conf | grep --quiet '^Storage=none$'
[[ "$(systemctl show caddy.service --property LimitCORE --value)" = 0 ]]
systemd-analyze security --no-pager caddy.service | tail -n 1
systemd-analyze security --no-pager --threshold=20 caddy.service > /dev/null
systemd-analyze security --no-pager nylzo-update.service | tail -n 1
echo 'NYLZO_VM_SANDBOX_VERIFIED'
systemctl is-active --quiet nylzo-bandwidth.service
interface=$(ip -json -4 route show default | /opt/nylzo/bin/jq --exit-status --raw-output '.[0].dev')
[[ "$(sysctl -n "net.ipv4.conf.$interface.rp_filter")" = 2 ]]
[[ "$(sysctl -n "net.ipv6.conf.$interface.accept_redirects")" = 0 ]]
networkctl reload
sleep 2
tc -json qdisc show dev "$interface" | /opt/nylzo/bin/jq --exit-status \
  'any(.[]; .root == true and .kind == "tbf" and .options.rate == 5000000)' > /dev/null
echo 'NYLZO_VM_TRAFFIC_CEILING_VERIFIED'
unstarted=$(docker create "$(docker inspect nylzo --format '{{.Config.Image}}')")
docker cp "$unstarted:/ko-app/nylzo" "$directory/nylzo"
docker rm "$unstarted" > /dev/null
chmod 0755 "$directory/nylzo"
verify_client() {
  local attempt
  # Type=simple reports a started process before the container serves HTTP.
  for ((attempt = 0; attempt < 60; attempt++)); do
    if curl --fail --silent --max-time 3 http://127.0.0.1/healthz > /dev/null; then
      "$directory/nylzo" verify-client --server http://127.0.0.1
      return
    fi
    sleep 1
  done
  echo 'The application did not become ready through Caddy.' >&2
  return 1
}
verify_client
probe=$(mktemp -d /var/tmp/nylzo-selinux.XXXXXXXX)
trap 'docker rm --force nylzo-selinux-test >/dev/null 2>&1 || true; rm -rf "$probe"' EXIT
mkdir "$probe/data" "$probe/epoch"
chown 165532:165532 "$probe/data" "$probe/epoch"
image=$(docker inspect nylzo --format '{{.Config.Image}}')
level=s0:c0,c1
if [[ "$(docker inspect nylzo --format '{{.ProcessLabel}}')" = *":$level" ]]; then level=s0:c2,c3; fi
if timeout 15 docker run --rm --name nylzo-selinux-test --network none --user 65532:65532 \
  --read-only --cap-drop ALL --security-opt no-new-privileges:true --security-opt "label=level:$level" \
  --memory 1g --cpus 1 --pids-limit 128 --ulimit memlock=-1:-1 --ulimit core=0:0 \
  --env-file /etc/nylzo/service.env --env NYLZO_EPOCH_DIR=/run/nylzo-epoch \
  --volume "$probe/data:/home/nonroot:Z" \
  --volume "$probe/epoch:/run/nylzo-epoch:Z" \
  --volume /var/lib/nylzo-secrets/pepper:/run/nylzo-pepper:ro "$image" serve > "$probe/result" 2>&1; then
  status=0
else
  status=$?
fi
docker rm --force nylzo-selinux-test >/dev/null 2>&1 || true
if [[ "$status" != 1 ]] || ! grep --fixed-strings --quiet 'permission denied' "$probe/result"; then
  echo 'The isolated container did not fail with the expected access denial.' >&2
  exit 1
fi
echo 'NYLZO_VM_SELINUX_ISOLATION_VERIFIED'
/opt/nylzo/runtime/runtime-stage
runtime_target=$(readlink /etc/extensions/docker.raw)
[[ "$runtime_target" = /opt/nylzo/extensions/docker-*-x86-64.raw ]]
[[ "$(readlink /etc/extensions/docker-flatcar.raw)" = /dev/null ]]
[[ "$(readlink /etc/extensions/containerd-flatcar.raw)" = /dev/null ]]
bad_runtime="$directory/bad-runtime.json"
/opt/nylzo/bin/jq '.amd64 = ("0" * 64)' /opt/nylzo/runtime/runtime-profile > "$bad_runtime"
if /opt/nylzo/runtime/runtime-stage "$bad_runtime"; then
  echo 'A runtime image with the wrong checksum was accepted.' >&2
  exit 1
fi
[[ "$(readlink /etc/extensions/docker.raw)" = "$runtime_target" ]]
ln --symbolic --force --no-dereference --no-target-directory /tmp/unmanaged-docker.raw /etc/extensions/docker.raw
if /opt/nylzo/runtime/runtime-stage; then
  echo 'An unmanaged Docker extension override was replaced.' >&2
  exit 1
fi
[[ "$(readlink /etc/extensions/docker.raw)" = /tmp/unmanaged-docker.raw ]]
ln --symbolic --force --no-dereference --no-target-directory "$runtime_target" /etc/extensions/docker.raw
echo 'NYLZO_VM_RUNTIME_INTEGRITY_VERIFIED'
if [[ ! -e "$directory/rebooted" ]]; then
  printf 'Synthetic deployment acceptance payload.\n' > "$directory/message"
  "$directory/nylzo" create --server http://127.0.0.1 --ttl 1h < "$directory/message" > "$directory/restart-link"
  cp -a /opt/nylzo/host/initial /opt/nylzo/host/release-v0.0.2
  printf '\n{ invalid_vm_global_option }\n' >> /opt/nylzo/host/release-v0.0.2/proxy/Caddyfile
  previous_caddy=$(sha256sum /etc/caddy/Caddyfile)
  if bash /opt/nylzo/host/release-v0.0.2/update/activate /opt/nylzo/host/release-v0.0.2; then
    echo 'An invalid Caddyfile was activated.' >&2
    exit 1
  fi
  [[ "$(sha256sum /etc/caddy/Caddyfile)" = "$previous_caddy" ]]
  [[ "$(readlink -e /opt/nylzo/host/current)" = /opt/nylzo/host/initial ]]
  verify_client
  echo 'NYLZO_VM_INVALID_CADDY_CONFIGURATION_REJECTED'
  rm -rf /opt/nylzo/host/release-v0.0.1
  cp -a /opt/nylzo/host/initial /opt/nylzo/host/release-v0.0.1
  sed -i 's/^OnUnitActiveSec=15min$/OnUnitActiveSec=14min/' /opt/nylzo/host/release-v0.0.1/monitoring/nylzo-clock.timer
  printf '\n# Exercise a live containerd configuration update.\n' >> /opt/nylzo/host/release-v0.0.1/system/containerd.toml
  printf '\n# Exercise validation of a changed Caddyfile.\n' >> /opt/nylzo/host/release-v0.0.1/proxy/Caddyfile
  # Existing hosts may still have the unused vendor reboot timer running.
  mkdir -p /run/systemd/system/systemd-sysupdate-reboot.timer.d
  printf '[Timer]\nOnCalendar=\nOnActiveSec=1d\nRandomizedDelaySec=0\n' > /run/systemd/system/systemd-sysupdate-reboot.timer.d/99-nylzo-acceptance.conf
  systemctl unmask --quiet systemd-sysupdate-reboot.timer
  systemctl daemon-reload
  systemctl start systemd-sysupdate-reboot.timer
  systemctl is-active --quiet systemd-sysupdate-reboot.timer
  bash /opt/nylzo/host/release-v0.0.1/update/activate /opt/nylzo/host/release-v0.0.1
  [[ "$(systemctl show systemd-sysupdate-reboot.timer --property=LoadState --value)" = masked ]]
  [[ "$(systemctl show systemd-sysupdate-reboot.timer --property=ActiveState --value)" = inactive ]]
  [[ "$(systemctl show systemd-sysupdate-reboot.timer --property=Result --value)" = success ]]
  rm /run/systemd/system/systemd-sysupdate-reboot.timer.d/99-nylzo-acceptance.conf
  systemctl daemon-reload
  echo 'NYLZO_VM_RUNNING_TIMER_MASKED_CLEANLY'
  systemctl cat nylzo-clock.timer | grep --quiet '^OnUnitActiveSec=14min$'
  for unit in containerd.service docker.service nylzo.service caddy.service update-engine.service locksmithd.service; do
    systemctl is-active --quiet "$unit"
  done
  /opt/nylzo/runtime/host-policy
  verify_client
  [[ "$(readlink -e /opt/nylzo/host/previous)" = /opt/nylzo/host/initial ]]
  bash /opt/nylzo/host/initial/update/activate /opt/nylzo/host/initial
  systemctl cat nylzo-clock.timer | grep --quiet '^OnUnitActiveSec=15min$'
  for unit in nylzo-firewall.service nylzo-clock.timer nylzo-host-status.timer caddy.service nylzo.service; do
    systemctl is-active --quiet "$unit"
  done
  /opt/nylzo/runtime/host-policy
  verify_client
  "$directory/nylzo" read --stdout < "$directory/restart-link" > "$directory/received"
  cmp "$directory/message" "$directory/received"
  echo 'NYLZO_VM_HOST_BUNDLE_ROLLBACK_VERIFIED'
  "$directory/nylzo" create --server http://127.0.0.1 --ttl 1h < "$directory/message" > "$directory/live-link"
  "$directory/nylzo" create --server http://127.0.0.1 --ttl 1h < "$directory/message" > "$directory/burned-link"
  "$directory/nylzo" burn < "$directory/burned-link"
  sha256sum /var/lib/nylzo-secrets/pepper > "$directory/pepper.sha256"
  touch "$directory/rebooted"
  sync
  echo 'NYLZO_VM_REBOOT_READY'
  systemctl reboot
else
  sha256sum --check "$directory/pepper.sha256"
  if "$directory/nylzo" read --stdout < "$directory/live-link" > /dev/null 2>&1; then
    echo 'A message survived destruction of the volatile epoch seed during reboot.' >&2
    exit 1
  fi
  if "$directory/nylzo" read --stdout < "$directory/burned-link" > /dev/null 2>&1; then
    echo 'Burned message was resurrected.' >&2
    exit 1
  fi
  "$directory/nylzo" create --server http://127.0.0.1 --ttl 1h < "$directory/message" > "$directory/new-link"
  "$directory/nylzo" read --stdout < "$directory/new-link" > "$directory/received"
  cmp "$directory/message" "$directory/received"
  echo 'NYLZO_VM_EPOCH_REBOOT_VERIFIED'
  echo 'NYLZO_VM_ACCEPTANCE_PASSED'
  systemctl poweroff
fi
