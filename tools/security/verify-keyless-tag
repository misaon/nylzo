#!/usr/bin/env bash
set -euo pipefail

[[ $# = 3 && "$GITHUB_REPOSITORY" = misaon/nylzo ]] || exit 1
tag="$1"
commit="$2"
trigger="$3"
[[ "$tag" =~ ^(v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)|automation-probe-[0-9]+)$ ]] || exit 1
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || exit 1
if [[ "$trigger" = workflow_dispatch ]]; then
  [[ "$tag" =~ ^automation-probe-[0-9]+$ ]] || exit 1
  [[ "${GITHUB_WORKFLOW_REF:-}" =~ ^misaon/nylzo/\.github/workflows/security-updates\.yml@refs/heads/[A-Za-z0-9_./-]+$ ]] || exit 1
  identity="https://github.com/${GITHUB_WORKFLOW_REF}"
else
  [[ "$trigger" = workflow_run && "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || exit 1
  identity="https://github.com/${GITHUB_REPOSITORY}/.github/workflows/security-updates.yml@refs/heads/main"
fi
[[ "$(git rev-parse "refs/tags/${tag}^{commit}")" = "$commit" ]] || exit 1
policy_commit="$commit"
if [[ "$trigger" = workflow_run ]]; then
  claims=$(git cat-file tag "refs/tags/$tag" | sed -n '/^$/,$p')
  if grep -q '^Policy-Commit:' <<< "$claims"; then
    [[ $(grep -c '^Policy-Commit:' <<< "$claims") = 1 ]] || exit 1
    policy_commit=$(sed -n 's/^Policy-Commit: //p' <<< "$claims")
    [[ "$policy_commit" =~ ^[a-f0-9]{40}$ ]] || exit 1
    git fetch --no-tags origin '+refs/heads/main:refs/remotes/origin/main'
    git merge-base --is-ancestor "$policy_commit" refs/remotes/origin/main
  fi
fi
for attempt in 1 2 3 4; do
  if gitsign verify-tag \
    --certificate-identity "$identity" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    --certificate-github-workflow-sha "$policy_commit" \
    --certificate-github-workflow-trigger "$trigger" "$tag"; then
    exit 0
  fi
  if [[ "$attempt" != 4 ]]; then sleep 5; fi
done
exit 1
