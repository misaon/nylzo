#!/usr/bin/env bash
set -euo pipefail

[[ "$GITHUB_REPOSITORY" = misaon/nylzo ]] || exit 1
[[ "$GITHUB_REF_NAME" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || exit 1
reference="refs/tags/${GITHUB_REF_NAME}"
git fetch --force --no-tags origin "${reference}:${reference}" "+refs/heads/main:refs/remotes/origin/main"
[[ "$(git cat-file -t "$reference")" = tag ]] || exit 1
[[ "$(git rev-parse "${reference}^{commit}")" = "$GITHUB_SHA" ]] || exit 1
[[ "$(git cat-file tag "$reference" | sed -n '/^$/q;s/^tag //p')" = "$GITHUB_REF_NAME" ]] || exit 1
on_main=false
if git merge-base --is-ancestor "$GITHUB_SHA" refs/remotes/origin/main; then on_main=true; fi
object=$(git rev-parse "$reference")
gh api "repos/${GITHUB_REPOSITORY}/git/tags/${object}" > "${RUNNER_TEMP}/release-tag.json"
if [[ "$(jq -r .verification.verified "${RUNNER_TEMP}/release-tag.json")" = true ]]; then
  [[ "$on_main" = true ]] || exit 1
  [[ -n "$RELEASE_TAGGER_EMAIL" ]] || exit 1
  [[ "$(jq -r .tagger.email "${RUNNER_TEMP}/release-tag.json")" = "$RELEASE_TAGGER_EMAIL" ]] || exit 1
  echo 'environment=release' >> "$GITHUB_OUTPUT"
else
  [[ "${SECURITY_AUTOMATION_ENABLED:-}" = true ]] || exit 1
  [[ -n "${DEPENDENCY_APP_SLUG:-}" && "$GITHUB_ACTOR" = "${DEPENDENCY_APP_SLUG}[bot]" ]] || exit 1
  bash "$(dirname "$0")/verify-keyless-tag" "$GITHUB_REF_NAME" "$GITHUB_SHA" workflow_run
  if [[ "$on_main" != true ]]; then
    claims=$(git cat-file tag "$reference" | sed -n '/^$/,$p')
    [[ $(grep -c '^Base-Release:' <<< "$claims") = 1 && $(grep -c '^Release-Kind:' <<< "$claims") = 1 ]] || exit 1
    base=$(sed -n 's/^Base-Release: //p' <<< "$claims")
    kind=$(sed -n 's/^Release-Kind: //p' <<< "$claims")
    [[ "$base" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ && "$kind" = security ]] || exit 1
    [[ "${base%.*}" = "${GITHUB_REF_NAME%.*}" && "${GITHUB_REF_NAME##*.}" = "$(( ${base##*.} + 1 ))" ]] || exit 1
    [[ "$(gh api "repos/${GITHUB_REPOSITORY}/releases/latest" --jq .tag_name)" = "$base" ]] || exit 1
    branch="release/${base%.*}"
    git fetch --no-tags origin "+refs/heads/$branch:refs/remotes/origin/$branch"
    [[ "$(git rev-parse "refs/remotes/origin/$branch")" = "$GITHUB_SHA" ]] || exit 1
    git merge-base --is-ancestor "$base" "$GITHUB_SHA"
  fi
  echo 'environment=release-automatic' >> "$GITHUB_OUTPUT"
fi
