{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "mergeConfidence:all-badges",
    "security:openssf-scorecard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Prague",
  "dependencyDashboard": false,
  "enabledManagers": [
    "gomod",
    "github-actions",
    "docker-compose",
    "mise",
    "terraform",
    "custom.regex",
    "bun",
    "bun-version"
  ],
  "platformCommit": "enabled",
  "ignoreScripts": true,
  "ignorePlugins": true,
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "misaon"
  ],
  "branchPrefix": "renovate/",
  "baseBranchPatterns": [
    "main",
    "/^release\\/v(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$/"
  ],
  "prConcurrentLimit": 12,
  "prHourlyLimit": 0,
  "schedule": [
    "* 0-14 * * 1,3,5"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "pin",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodTidyAll"
  ],
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "stopUpdatingLabel": "manual-hold",
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "security"
    ],
    "automerge": true,
    "draftPR": false,
    "minimumReleaseAge": null,
    "semanticCommitType": "fix"
  },
  "osvVulnerabilityAlerts": true,
  "statusCheckWhen": {
    "artifactError": "never",
    "configValidation": "never",
    "mergeConfidence": "never",
    "minimumReleaseAge": "never"
  },
  "logLevelRemap": [
    {
      "matchMessage": "/^(?:Error updating branch:|artifactErrors$)/",
      "newLogLevel": "error"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bun /opt/nylzo-dependency-sync.ts"
    ],
    "installTools": {
      "bun": {}
    },
    "fileFilters": [
      "deploy/hetzner-flatcar/toolchain.json",
      "mise-tasks/deploy"
    ],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "github.com/misaon/nylzo",
        "ghcr.io/misaon/nylzo"
      ],
      "enabled": false
    },
    {
      "description": "Infrastructure: tools in mise.toml, OpenTofu providers, Compose images and pinned binaries.",
      "matchManagers": [
        "mise",
        "terraform",
        "docker-compose",
        "custom.regex"
      ],
      "groupName": "infrastructure dependencies",
      "groupSlug": "infrastructure",
      "addLabels": [
        "infrastructure"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "infrastructure"
    },
    {
      "description": "CI: GitHub Actions in workflows and composite actions.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "addLabels": [
        "ci"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "CI: the automation workspace.",
      "matchFileNames": [
        "automation/**"
      ],
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "addLabels": [
        "ci"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Frontend: the web workspace.",
      "matchFileNames": [
        "web/**"
      ],
      "groupName": "frontend dependencies",
      "groupSlug": "frontend",
      "addLabels": [
        "frontend"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "frontend"
    },
    {
      "description": "Backend: the server module and the Caddy module.",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "backend dependencies",
      "groupSlug": "backend",
      "addLabels": [
        "backend"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "backend"
    },
    {
      "description": "The Go toolchain moves in mise.toml and both Go modules at once, Caddy in its module and Compose.",
      "matchPackageNames": [
        "go",
        "golang/go",
        "golangci/golangci-lint",
        "golangci-lint",
        "github.com/caddyserver/caddy/v2",
        "caddy"
      ],
      "groupName": "backend dependencies",
      "groupSlug": "backend",
      "addLabels": [
        "backend"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "backend"
    },
    {
      "description": "Bun moves in mise.toml and every package.json at once.",
      "matchPackageNames": [
        "bun",
        "oven-sh/bun",
        "@types/bun"
      ],
      "groupName": "frontend dependencies",
      "groupSlug": "frontend",
      "addLabels": [
        "frontend"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "frontend"
    },
    {
      "description": "CI tools pinned across workflows, mise.toml and assets.json.",
      "matchPackageNames": [
        "jdx/mise",
        "golang.org/x/vuln",
        "ghcr.io/renovatebot/renovate",
        "renovatebot/github-action"
      ],
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "addLabels": [
        "ci"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Show age, confidence and the OpenSSF score together; prBodyColumns does not merge.",
      "matchSourceUrls": [
        "https://github.com/**"
      ],
      "prBodyColumns": [
        "Package",
        "Type",
        "Update",
        "Change",
        "Age",
        "Confidence",
        "Pending",
        "OpenSSF"
      ]
    },
    {
      "description": "Indirect Go modules update on main; maintenance branches take them only as security fixes.",
      "matchBaseBranches": [
        "main"
      ],
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "A new major of an indirect Go module is a different module that only its importer can adopt.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Only maintenance branches still pin the official Caddy image in Compose.",
      "matchBaseBranches": [
        "main"
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "terraform-provider",
        "terraform-module"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "A go line naming a full release stands in for a toolchain line that go mod tidy dropped, so it follows each Go release.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchCurrentValue": "/^\\d+\\.\\d+\\.\\d+$/",
      "rangeStrategy": "bump"
    },
    {
      "description": "Custom managers update these CLI inputs together with their verified binary checksums.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "goreleaser/goreleaser",
        "ghcr.io/renovatebot/renovate",
        "sigstore/cosign",
        "jdx/mise"
      ],
      "enabled": false
    },
    {
      "description": "Follow even-year Ubuntu LTS tags; test OS upgrades still require review.",
      "matchPackageNames": [
        "ubuntu"
      ],
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    },
    {
      "description": "modernc.org/libc follows modernc.org/sqlite; a libc major on its own is never wanted.",
      "matchPackageNames": [
        "modernc.org/libc"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "typescript-eslint and svelte-check in the web app accept TypeScript only below 7; lift this once both support it.",
      "matchPackageNames": [
        "typescript"
      ],
      "matchFileNames": [
        "web/app/package.json"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "These workflows run only from main, so maintenance branches never need their updates.",
      "matchBaseBranches": [
        "/^release\\/v/"
      ],
      "matchFileNames": [
        ".github/workflows/monitor.yml",
        ".github/workflows/release-please.yml",
        ".github/workflows/release-tag.yml",
        ".github/workflows/renovate.yml",
        ".github/workflows/scorecard.yml",
        ".github/workflows/watch.yml",
        ".github/workflows/infrastructure.yml",
        ".github/workflows/infrastructure-stack.yml",
        ".github/actions/deploy-site/action.yml",
        ".github/actions/released-nylzo/action.yml"
      ],
      "enabled": false
    },
    {
      "description": "Updates that need no code change merge themselves once every required check is green.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Below 1.0 a minor can break; Go versions carry a v prefix. Each area collects them in one draft for review, on its own branch next to the automatic group.",
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "additionalBranchPrefix": "below-1-",
      "commitMessageSuffix": "below 1.0",
      "automerge": false,
      "draftPR": true,
      "rebaseWhen": "conflicted",
      "addLabels": [
        "requires-attention"
      ]
    },
    {
      "description": "Breaking upgrades and package replacements need a planned migration and a code owner approval.",
      "matchUpdateTypes": [
        "major",
        "replacement"
      ],
      "groupName": null,
      "automerge": false,
      "draftPR": true,
      "rebaseWhen": "conflicted",
      "addLabels": [
        "requires-attention"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/dependencies/assets\\.json$/"
      ],
      "matchStrings": [
        "\"package\": \"(?<depName>[^\\\"]+)\", \"version\": \"(?<currentValue>[^\\\"]+)\", \"sha256\": \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.goreleaser\\.yaml$/"
      ],
      "matchStrings": [
        "base_image: (?<depName>gcr\\.io/distroless/static-debian13):(?<currentValue>nonroot)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "go run (?<depName>golang\\.org/x/vuln)/cmd/govulncheck@(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[A-Za-z0-9_./-]+)\\n[ \\t]*[a-z_-]+[ \\t]*[:=][ \\t]*[\"']?(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy/hetzner-flatcar/infrastructure/(image|server|dns)/main\\.tf$/"
      ],
      "matchStrings": [
        "(?:opentofu|required_version) = \"= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy/hetzner-flatcar/toolchain\\.json$/"
      ],
      "matchStrings": [
        "\"flatcar\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "flatcar-stable",
      "datasourceTemplate": "custom.flatcar",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate-image: (?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/deploy/runtime\\.test\\.mts$/"
      ],
      "matchStrings": [
        "\"(?<depName>ubuntu):(?<currentValue>[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "customDatasources": {
    "flatcar": {
      "defaultRegistryUrlTemplate": "https://www.flatcar.org/releases-json/releases-stable.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $map($keys($)[$ != \"current\"], function($v) { { \"version\": $v, \"releaseTimestamp\": $lookup($$, $v).release_date } }) }"
      ]
    }
  }
}
