{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "enabledManagers": [
    "npm",
    "gomod",
    "github-actions",
    "docker-compose",
    "mise",
    "terraform",
    "nodenv",
    "custom.regex"
  ],
  "platformCommit": "enabled",
  "pinDigests": true,
  "ignoreScripts": true,
  "ignorePlugins": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "misaon"
  ],
  "branchPrefix": "renovate/",
  "baseBranchPatterns": [
    "main",
    "/^release\\/v(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$/"
  ],
  "prConcurrentLimit": 8,
  "prHourlyLimit": 0,
  "schedule": [
    "* 0-7 * * 1"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "separateMinorPatch": false,
  "rangeStrategy": "pin",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "stopUpdatingLabel": "manual-hold",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": true,
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "statusCheckNames": {
    "artifactError": null,
    "configValidation": null,
    "mergeConfidence": null,
    "minimumReleaseAge": null
  },
  "logLevelRemap": [
    {
      "matchMessage": "/^(?:Error updating branch:|artifactErrors$)/",
      "newLogLevel": "error"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "node /opt/nylzo-dependency-sync.ts"
    ],
    "fileFilters": [
      "deploy/hetzner-flatcar/toolchain.json",
      "mise-tasks/deploy"
    ],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "github.com/misaon/nylzo",
        "ghcr.io/misaon/nylzo"
      ],
      "enabled": false
    },
    {
      "description": "Indirect Go modules update on main; maintenance branches take them only as security fixes.",
      "matchBaseBranches": [
        "main"
      ],
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "terraform-provider",
        "terraform-module"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Custom managers update these CLI inputs together with their verified binary checksums.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "goreleaser/goreleaser",
        "ghcr.io/renovatebot/renovate",
        "sigstore/cosign",
        "jdx/mise",
        "actions/node-versions"
      ],
      "enabled": false
    },
    {
      "description": "Follow even-year Ubuntu LTS tags; test OS upgrades still require review.",
      "matchPackageNames": [
        "ubuntu"
      ],
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Each tool updates every pin and checksum it owns in one PR.",
      "matchPackageNames": [
        "opentofu/opentofu"
      ],
      "groupName": "OpenTofu"
    },
    {
      "matchPackageNames": [
        "jdx/mise"
      ],
      "groupName": "mise"
    },
    {
      "matchPackageNames": [
        "caddy",
        "caddyserver/caddy"
      ],
      "groupName": "Caddy"
    },
    {
      "matchPackageNames": [
        "cli/cli"
      ],
      "groupName": "GitHub CLI"
    },
    {
      "matchPackageNames": [
        "sigstore/cosign"
      ],
      "groupName": "Cosign"
    },
    {
      "matchPackageNames": [
        "jqlang/jq"
      ],
      "groupName": "jq"
    },
    {
      "matchPackageNames": [
        "coreos/ignition"
      ],
      "groupName": "Ignition validator"
    },
    {
      "matchPackageNames": [
        "node",
        "nodejs/node"
      ],
      "groupName": "Node.js"
    },
    {
      "matchPackageNames": [
        "goreleaser/goreleaser"
      ],
      "groupName": "GoReleaser"
    },
    {
      "matchPackageNames": [
        "anchore/syft"
      ],
      "groupName": "Syft"
    },
    {
      "matchPackageNames": [
        "codecov/codecov-cli"
      ],
      "groupName": "Codecov CLI"
    },
    {
      "matchPackageNames": [
        "go",
        "golang/go"
      ],
      "groupName": "Go toolchain"
    },
    {
      "matchPackageNames": [
        "pnpm"
      ],
      "groupName": "pnpm"
    },
    {
      "description": "Review Node and its TypeScript declarations as one planned migration.",
      "matchBaseBranches": [
        "main"
      ],
      "matchPackageNames": [
        "node",
        "nodejs/node",
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Node.js migration"
    },
    {
      "description": "Breaking upgrades need a planned migration and a code owner approval.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "draftPR": true,
      "addLabels": [
        "requires-attention"
      ]
    },
    {
      "description": "Minor upgrades below 1.0 can break; treat them like majors.",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": null,
      "automerge": false,
      "draftPR": true,
      "addLabels": [
        "requires-attention"
      ]
    },
    {
      "description": "modernc.org/libc follows modernc.org/sqlite; a libc major on its own is never wanted.",
      "matchPackageNames": [
        "modernc.org/libc"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "typescript-eslint and svelte-check accept TypeScript only below 7; lift this once both support it.",
      "matchPackageNames": [
        "typescript"
      ],
      "matchFileNames": [
        "web/package.json",
        "web/app/package.json",
        "automation/package.json"
      ],
      "allowedVersions": "<7"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/dependencies/assets\\.json$/"
      ],
      "matchStrings": [
        "\"package\": \"(?<depName>[^\\\"]+)\", \"version\": \"(?<currentValue>[^\\\"]+)\", \"sha256\": \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.goreleaser\\.yaml$/"
      ],
      "matchStrings": [
        "base_image: (?<depName>gcr\\.io/distroless/static-debian13):(?<currentValue>nonroot)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "go run (?<depName>golang\\.org/x/vuln)/cmd/govulncheck@(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[A-Za-z0-9_./-]+)\\n[ \\t]*[a-z_-]+[ \\t]*[:=][ \\t]*[\"']?(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy/hetzner-flatcar/infrastructure/(image|server|dns)/main\\.tf$/"
      ],
      "matchStrings": [
        "required_version = \"= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy/hetzner-flatcar/toolchain\\.json$/"
      ],
      "matchStrings": [
        "\"flatcar\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "flatcar-stable",
      "datasourceTemplate": "custom.flatcar",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate-image: (?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/deploy/runtime\\.test\\.mts$/"
      ],
      "matchStrings": [
        "\"(?<depName>ubuntu):(?<currentValue>[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "customDatasources": {
    "flatcar": {
      "defaultRegistryUrlTemplate": "https://www.flatcar.org/releases-json/releases-stable.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $map($keys($), function($v) { { \"version\": $v } }) }"
      ]
    }
  }
}
