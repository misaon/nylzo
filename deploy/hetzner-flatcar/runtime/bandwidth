#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
export SYSTEMD_COLORS=0
# One public NIC shares this ceiling across IPv4, IPv6, HTTPS, SSH and updates.
# 40 Mbit/s for 31 days is 13.4 TB, below this profile's 20 TB allowance.
routes=$(ip -o -4 route show default && ip -o -6 route show default)
mapfile -t interfaces < <(awk '{ for (i=1; i<NF; i++) if ($i == "dev") print $(i+1) }' <<< "$routes" | sort -u)
[[ ${#interfaces[@]} = 1 && "${interfaces[0]}" =~ ^[a-zA-Z0-9_-]{1,15}$ ]] || {
  echo 'Traffic protection requires exactly one public default-route interface.' >&2
  exit 1
}
interface=${interfaces[0]}
network=$(networkctl --no-pager --full status "$interface" | sed -n 's/^[[:space:]]*Network File: //p')
[[ "$network" =~ ^/(usr/lib|run|etc)/systemd/network/([a-zA-Z0-9_.-]+\.network)$ ]] || {
  echo 'Traffic protection requires a managed systemd network configuration.' >&2
  exit 1
}
directory="/etc/systemd/network/${BASH_REMATCH[2]}.d"
mkdir -p "$directory"
configuration='[TokenBucketFilter]
Parent=root
Handle=1
Rate=40M
BurstBytes=64K
LatencySec=100ms
MPUBytes=128'
if [[ ! -f "$directory/90-nylzo-bandwidth.conf" ]] || [[ "$(cat "$directory/90-nylzo-bandwidth.conf")" != "$configuration" ]]; then
  printf '%s\n' "$configuration" > "$directory/90-nylzo-bandwidth.conf"
  networkctl reload
fi
tc qdisc replace dev "$interface" root handle 1: tbf rate 40mbit burst 65536 latency 100ms mpu 128
tc qdisc show dev "$interface" | grep --extended-regexp --quiet '^qdisc tbf 1: root .*rate 40Mbit '
