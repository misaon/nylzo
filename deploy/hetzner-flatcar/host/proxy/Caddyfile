{
	admin off
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		strict_sni_host on
		0rtt off
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 6m
			read_body_idle 20s
			write 6m
			idle 2m
		}
	}
	# A listener block replaces the one above for :80, which serves only HTTP/1.1 redirects and aborts.
	servers :80 {
		protocols h1
		0rtt off
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 20s
			read_body_idle 20s
			write 20s
			idle 2m
		}
	}
	log default {
		exclude http.log http.handlers http.stdlib http.auto_https admin
	}
}

{$NYLZO_DOMAIN} {
	tls {
		protocols tls1.3
		curves x25519mlkem768 x25519
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	request_body {
		max_size 6MiB
	}
	header {
		-Server
		-Via
	}
	route {
		nylzo_frontend https://{$NYLZO_DOMAIN} {
			maintenance /var/lib/nylzo-directive/maintenance
			contact {$NYLZO_CONTACT}
		}
		reverse_proxy 172.30.81.2:8080 {
			handle_response {
				route {
					nylzo_data
					copy_response
				}
			}
			header_up -X-Real-IP
			header_up -Forwarded
			header_up -X-Client-IP
			header_up -True-Client-IP
			header_up -CF-Connecting-IP
			header_up -Fastly-Client-IP
			header_up -X-Cluster-Client-IP
			header_up -Client-IP
			transport http {
				keepalive 25s
			}
		}
	}
	handle_errors {
		header -Server
		route {
			nylzo_error {
				contact {$NYLZO_CONTACT}
			}
		}
	}
}

http://{$NYLZO_DOMAIN} {
	header -Server
	redir https://{host}{uri} 308
}

http:// {
	abort
}

https:// {
	tls {
		protocols tls1.3
		curves x25519mlkem768
	}
	abort
}
