enable always nylzo-firewall.service
enable always nylzo-bandwidth.service
start always nylzo-ipv6.service
enable always nylzo-initialize.service
enable always nylzo-ssh-identity.service
enable always nylzo-host-status.timer
enable always nylzo-clock.timer
enable always nylzo-directive.timer
enable automatic-updates nylzo-update.timer
enable heartbeat nylzo-heartbeat.timer
mask always systemd-sysupdate-reboot.timer
mask always serial-getty@ttyS0.service
mask always getty@tty1.service
mask always google-oslogin-cache.timer
