#!/usr/bin/env bash
set -euo pipefail
digest=$(/opt/nylzo/bin/jq -er .digest /var/lib/nylzo-deploy/current.json)
[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || exit 1
exec docker run --rm --name nylzo --pull=never --user 65532:65532 \
  --network nylzo --ip 172.30.81.2 \
  --read-only --cap-drop ALL --security-opt no-new-privileges:true \
  --memory 1g --cpus 1.5 --pids-limit 128 --ulimit memlock=1073741824:1073741824 --ulimit core=0:0 \
  --env-file /etc/nylzo/service.env \
  --volume /var/lib/nylzo/data:/home/nonroot:Z \
  --volume /var/lib/nylzo-secrets/pepper:/run/nylzo-pepper:ro,Z \
  "ghcr.io/misaon/nylzo@$digest" serve
