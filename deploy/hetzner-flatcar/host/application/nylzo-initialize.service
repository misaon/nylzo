[Unit]
Requires=nylzo-tools.service nylzo-bandwidth.service nylzo-storage.service
Wants=docker.service
After=nylzo-tools.service nylzo-bandwidth.service docker.service network-online.target nylzo-storage.service
[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=15min
ExecStartPre=/usr/bin/systemctl is-active --quiet docker.service
ExecStart=+/opt/nylzo/runtime/prepare
ExecStart=/opt/nylzo/runtime/update initialize
[Install]
WantedBy=multi-user.target
