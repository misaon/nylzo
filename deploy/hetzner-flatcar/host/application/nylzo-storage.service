[Unit]
Description=Open the encrypted data volume when the host requires one
Wants=network-online.target
# Flatcar grows the root filesystem on first boot; the free-space check must see the final size.
After=network-online.target nylzo-firewall.service extend-filesystems.service
Before=nylzo-initialize.service nylzo.service caddy.service nylzo-host-status.service
[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=10min
ExecStart=/opt/nylzo/runtime/storage
ExecReload=/opt/nylzo/runtime/storage
