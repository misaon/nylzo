#!/usr/bin/env bash
# Applies the production directive that the production watch signs on main: maintenance or normal.
set -euo pipefail
umask 022
export PATH="/opt/nylzo/bin:$PATH"
readonly source="${NYLZO_DIRECTIVE_SOURCE:-https://raw.githubusercontent.com/misaon/nylzo/production-directive}"
readonly state="${NYLZO_DIRECTIVE_DIR:-/var/lib/nylzo-directive}"
readonly identity=https://github.com/misaon/nylzo/.github/workflows/watch.yml@refs/heads/main
readonly domain="${NYLZO_DOMAIN:?NYLZO_DOMAIN must name this instance}"

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT

download() {
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
    --max-time 30 --max-filesize 65536 "$source/$1" --output "$temporary/$1"
}

# Before the first directive exists, and while GitHub is unreachable, the current state stays.
download directive.json 2> /dev/null || exit 0
issued=$(jq -er '.issued | select(type == "number" and . > 0 and . == floor)' "$temporary/directive.json")
instance=$(jq -r '.instance' "$temporary/directive.json")
# Other instances built from this profile ignore the directives of this one.
if [[ "$instance" != "$domain" ]]; then
  [[ "$(cat "$state/ignored" 2> /dev/null)" = "$issued" ]] || echo "Ignored the directive issued at $issued for $instance; this host is $domain." >&2
  printf '%s\n' "$issued" > "$state/ignored"
  exit 0
fi
applied=0
if [[ -s "$state/issued" ]]; then applied=$(< "$state/issued"); fi
[[ "$applied" =~ ^[0-9]+$ ]] || applied=0
# An older signed directive cannot undo a newer one; only a newer one is worth a signature check.
(( issued > applied )) || exit 0
download directive.json.sigstore.json
cosign verify-blob "$temporary/directive.json" --bundle "$temporary/directive.json.sigstore.json" \
  --certificate-identity "$identity" --certificate-oidc-issuer https://token.actions.githubusercontent.com > /dev/null
wanted=$(jq -er 'select(.format == 1) | .state | select(. == "maintenance" or . == "normal")' "$temporary/directive.json")

if [[ "$wanted" = maintenance ]]; then
  : > "$state/maintenance.new"
  chmod 0644 "$state/maintenance.new"
  mv -f "$state/maintenance.new" "$state/maintenance"
else
  rm -f "$state/maintenance"
fi
printf '%s\n' "$issued" > "$state/issued.new"
mv -f "$state/issued.new" "$state/issued"
echo "Applied the $wanted directive issued at $issued."
