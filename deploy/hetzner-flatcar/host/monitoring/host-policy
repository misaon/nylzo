#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
[[ "$(getenforce)" = Enforcing ]] || { echo 'SELinux enforcement is required.' >&2; exit 1; }
swaps=$(swapon --noheadings --show)
[[ -z "$swaps" ]] || { echo 'Swap must stay off: the epoch seed lives on tmpfs, whose pages could reach the disk.' >&2; exit 1; }
for check in kernel.dmesg_restrict=1 kernel.kptr_restrict=2 kernel.kexec_load_disabled=1 kernel.io_uring_disabled=2 kernel.sysrq=0 dev.tty.ldisc_autoload=0 fs.suid_dumpable=0 net.ipv4.conf.all.rp_filter=2; do
  [[ "$(sysctl -n "${check%%=*}")" = "${check#*=}" ]] || { echo "Host policy failed: ${check%%=*}" >&2; exit 1; }
done
interface=$(ip -o -4 route show default | awk '{ for (i=1; i<NF; i++) if ($i == "dev") print $(i+1) }' | sort -u)
[[ "$interface" =~ ^[a-zA-Z0-9_-]{1,15}$ ]]
for check in "net.ipv4.conf.$interface.rp_filter=2" "net.ipv4.conf.$interface.accept_redirects=0" "net.ipv4.conf.$interface.send_redirects=0" "net.ipv6.conf.$interface.accept_redirects=0"; do
  [[ "$(sysctl -n "${check%%=*}")" = "${check#*=}" ]] || { echo "Host policy failed: ${check%%=*}" >&2; exit 1; }
done
if [[ -s "${NYLZO_TANG_CONFIGURATION:-/etc/nylzo/tang.json}" ]]; then
  for directory in /var/lib/nylzo /var/lib/nylzo-secrets /var/lib/caddy /var/log/journal; do
    [[ "$(findmnt --noheadings --output SOURCE --mountpoint "$directory")" = "/dev/mapper/nylzo-storage[/${directory##*/}]" ]] || { echo "Encrypted storage is not mounted at $directory." >&2; exit 1; }
  done
fi
tc qdisc show dev "$interface" | grep --extended-regexp --quiet '^qdisc tbf 1: root .*rate 40Mbit '
firewall=$(nft list chain inet nylzo input) || { echo 'The host firewall is not loaded.' >&2; exit 1; }
grep --quiet --fixed-strings 'type filter hook input priority filter; policy drop;' <<< "$firewall" || { echo 'The host firewall does not drop unlisted input.' >&2; exit 1; }
options=$(docker info --format '{{range .SecurityOptions}}{{println .}}{{end}}')
for required in name=selinux name=userns name=no-new-privileges; do
  grep --fixed-strings --line-regexp --quiet "$required" <<< "$options"
done
grep --extended-regexp --quiet '^name=seccomp,profile=' <<< "$options"
plugins=$(ctr plugins ls)
awk '$1 == "io.containerd.runtime.v2" && $2 == "task" && $NF == "ok" { found=1 } END { exit !found }' <<< "$plugins"
if awk '$NF == "ok" && ($1 ~ /\.cri\./ || ($1 == "io.containerd.grpc.v1" && ($2 == "cri" || $2 == "transfer")) || $1 == "io.containerd.transfer.v1") { found=1 } END { exit !found }' <<< "$plugins"; then
  echo 'Unused containerd CRI or transfer interfaces are active.' >&2
  exit 1
fi
