#!/usr/bin/env bash
set -euo pipefail
umask 077
export LC_ALL=C
export PATH="/opt/nylzo/bin:/opt/nylzo/runtime:$PATH"
semantic='^v(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$'
current=${1:-}
[[ "$current" =~ $semantic ]] || { echo 'Usage: release-target vX.Y.Z' >&2; exit 2; }
temporary=$(mktemp -d /var/tmp/nylzo-release-target.XXXXXXXX)
trap 'rm -rf "$temporary"' EXIT
releases=https://api.github.com/repos/misaon/nylzo/releases
download() {
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 --max-time 90 --max-filesize 33554432 "$1" --output "$2"
}
line() {
  local version=${1#v}
  printf '%s\n' "${version%.*}"
}
newer() {
  [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort --version-sort | tail -n 1)" = "$2" ]]
}
download "$releases/latest" "$temporary/latest.json"
latest=$(jq -er 'select(.draft == false and .prerelease == false) | .tag_name' "$temporary/latest.json")
[[ "$latest" =~ $semantic ]] || exit 1
[[ "$latest" != "$current" ]] || exit 0
newer "$current" "$latest" || { echo 'Nylzo downgrade refused.' >&2; exit 1; }
if [[ "$(line "$latest")" = "$(line "$current")" ]]; then
  printf '%s\n' "$latest"
  exit 0
fi
base="v$(line "$latest").0"
if release-policy "$base"; then
  printf '%s\n' "$latest"
  exit 0
fi
echo "$base carries no signed planned-release approval; looking for a patch of the installed line instead." >&2
download "$releases?per_page=100" "$temporary/releases.json"
patch=$(jq -r --arg prefix "v$(line "$current")." '.[] | select(.draft == false and .prerelease == false) | .tag_name | select(startswith($prefix))' "$temporary/releases.json" |
  grep --extended-regexp "$semantic" | sort --version-sort | tail -n 1 || true)
if [[ -n "$patch" ]] && newer "$current" "$patch"; then
  printf '%s\n' "$patch"
  exit 0
fi
echo 'A signed, explicitly approved planned release is required for a minor or major upgrade.' >&2
exit 1
