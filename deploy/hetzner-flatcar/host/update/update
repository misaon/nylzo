#!/usr/bin/env bash
set -euo pipefail
umask 077
export PATH="/opt/nylzo/bin:$PATH"
export GH_CONFIG_DIR=/run/nylzo-deploy-gh
unset GH_TOKEN GITHUB_TOKEN
if [[ "${1:-}" = check ]]; then
  status=0
  /opt/nylzo/runtime/update nylzo || status=1
  exit "$status"
fi
exec 9>/run/nylzo-deploy.lock
flock --nonblock 9 || exit 0
site=/etc/nylzo/site.json
state=/var/lib/nylzo-deploy
mkdir -p "$state" "$GH_CONFIG_DIR"
[[ ! -e "$state/failed.json" ]] || { echo 'A failed deployment requires inspection; database rollback is refused.' >&2; exit 1; }
temporary=$(mktemp -d /var/tmp/nylzo-update.XXXXXXXX)
cleanup() {
  docker rm --force nylzo-probe >/dev/null 2>&1 || true
  rm -rf "$temporary"
}
trap cleanup EXIT
download() {
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 --max-time 180 --max-filesize 134217728 "$1" --output "$2"
}
older() {
  [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort --version-sort | head -n 1)" = "$1" ]]
}
checksums() {
  local release="$1"
  [[ "$(cat "$temporary/checksums.release" 2>/dev/null)" != "$release" ]] || return 0
  if ! jq -e --arg version "$release" '.tag_name == $version' "$temporary/release.json" >/dev/null 2>&1; then
    download "https://api.github.com/repos/misaon/nylzo/releases/tags/$release" "$temporary/release.json"
  fi
  jq -e --arg version "$release" '.tag_name == $version and .immutable == true and .draft == false and .prerelease == false' "$temporary/release.json" >/dev/null
  for file in checksums.txt checksums.txt.sigstore.json; do
    download "https://github.com/misaon/nylzo/releases/download/$release/$file" "$temporary/$file"
  done
  cosign verify-blob "$temporary/checksums.txt" --bundle "$temporary/checksums.txt.sigstore.json" \
    --certificate-identity "https://github.com/misaon/nylzo/.github/workflows/release.yml@refs/tags/$release" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null
  printf '%s\n' "$release" > "$temporary/checksums.release"
}
provenance() {
  local file="$1" release="$2" digest
  digest=$(sha256sum "$file" | cut -d ' ' -f 1)
  download "https://api.github.com/repos/misaon/nylzo/attestations/sha256:$digest" "$file.provenance.json"
  jq -ce '.attestations[].bundle' "$file.provenance.json" > "$file.provenance.jsonl"
  gh attestation verify "$file" --bundle "$file.provenance.jsonl" --repo misaon/nylzo \
    --signer-workflow misaon/nylzo/.github/workflows/release.yml --source-ref "refs/tags/$release" --deny-self-hosted-runners >/dev/null
}
listed() {
  awk -v name="$1" '$2 == name { found++ } END { exit found != 1 }' "$temporary/checksums.txt"
}
matches() {
  (cd "$temporary" && awk -v name="$1" '$2 == name { print; found++ } END { if (found != 1) exit 1 }' checksums.txt | sha256sum --check --strict >/dev/null)
}
host() {
  local release="$1" archive library=/opt/nylzo/host directory current proxy=inactive
  checksums "$release"
  archive="nylzo-host_${release#v}.tar"
  if ! listed "$archive"; then
    echo "Release $release ships no host bundle; the installed host configuration stays." >&2
    return 0
  fi
  directory="$library/release-$release"
  current=$(readlink -e "$library/current" 2>/dev/null || true)
  [[ -n "$current" && -d "$current" ]] || { echo 'Install a host bundle once by hand before automatic host updates; see the Hetzner Flatcar guide.' >&2; return 1; }
  [[ "$current" != "$directory" ]] || return 0
  download "https://github.com/misaon/nylzo/releases/download/$release/$archive" "$temporary/$archive"
  matches "$archive"
  provenance "$temporary/$archive" "$release"
  if tar --list --file "$temporary/$archive" | grep --invert-match --extended-regexp --quiet '^(manifest|units|[a-z]+/|[a-z]+/[A-Za-z0-9.-]+)$'; then
    echo 'The host bundle contains unexpected paths.' >&2
    return 1
  fi
  rm -rf "$directory.staged"
  mkdir -p "$directory.staged"
  tar --extract --file "$temporary/$archive" --directory "$directory.staged" --no-same-owner --no-same-permissions
  rm -rf "$directory"
  mv "$directory.staged" "$directory"
  if systemctl is-active --quiet caddy.service; then proxy=active; fi
  if bash "$directory/update/activate" "$directory" && sleep 2 && /opt/nylzo/runtime/host-policy && { [[ "$proxy" != active ]] || systemctl is-active --quiet caddy.service; }; then
    return 0
  fi
  echo "Host configuration from $release failed its checks; restoring ${current##*/}." >&2
  bash "$current/update/activate" "$current" || true
  return 1
}
upstream() {
  local version="$1" architecture="$2" base archive
  base="https://github.com/caddyserver/caddy/releases/download/$version/caddy_${version#v}"
  for suffix in checksums.txt checksums.txt.pem checksums.txt.sig; do download "${base}_${suffix}" "$temporary/upstream-$suffix"; done
  cosign verify-blob "$temporary/upstream-checksums.txt" --certificate "$temporary/upstream-checksums.txt.pem" --signature "$temporary/upstream-checksums.txt.sig" \
    --certificate-identity "https://github.com/caddyserver/caddy/.github/workflows/release.yml@refs/tags/$version" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null
  archive="caddy_${version#v}_linux_${architecture}.tar.gz"
  download "${base}_linux_${architecture}.tar.gz" "$temporary/$archive"
  (cd "$temporary" && awk -v name="$archive" '$2 == name { print; found++ } END { if (found != 1) exit 1 }' upstream-checksums.txt | sha512sum --check --strict >/dev/null)
  tar --extract --gzip --file "$temporary/$archive" --to-stdout caddy > "$temporary/caddy"
}
caddy() {
  local release="$1" previous="" candidate directory architecture archive built restart=true
  [[ "$release" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || return 1
  [[ ! -s "$state/caddy.tag" ]] || previous=$(cat "$state/caddy.tag")
  [[ -z "$previous" || "$previous" =~ ^(release-)?v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || return 1
  if [[ "$previous" = release-* ]]; then
    [[ "$previous" != "release-$release" ]] || { systemctl start caddy.service; return; }
    older "${previous#release-}" "$release" || { echo 'Caddy downgrade refused.' >&2; return 1; }
  fi
  checksums "$release"
  architecture=$(jq -r .architecture "$site")
  archive="nylzo-caddy_${release#v}_linux_${architecture}.tar.gz"
  if listed "$archive"; then
    candidate="release-$release"
    download "https://github.com/misaon/nylzo/releases/download/$release/$archive" "$temporary/$archive"
    matches "$archive"
    provenance "$temporary/$archive" "$release"
    tar --extract --gzip --file "$temporary/$archive" --to-stdout caddy > "$temporary/caddy"
  else
    [[ -n "$previous" ]] || { echo "Release $release ships no Caddy build; provision from a release that does." >&2; return 1; }
    if [[ "$previous" = release-* ]]; then
      echo "Release $release ships no Caddy build; Caddy from ${previous#release-} stays installed." >&2
      systemctl start caddy.service
      return
    fi
    candidate="$previous"
    [[ ! -s "$state/caddy.approved.tag" ]] || candidate=$(cat "$state/caddy.approved.tag")
    [[ "$candidate" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || return 1
    [[ "$candidate" != "$previous" ]] || { systemctl start caddy.service; return; }
    older "$previous" "$candidate" || { echo 'Caddy downgrade refused.' >&2; return 1; }
    upstream "$candidate" "$architecture"
  fi
  directory="/opt/nylzo/caddy/$candidate"
  mkdir -p /opt/nylzo/caddy "$directory"
  chmod 0755 /opt/nylzo/caddy "$directory"
  cp "$temporary/caddy" "$directory/caddy"
  chmod 0755 "$directory/caddy"
  export NYLZO_DOMAIN
  NYLZO_DOMAIN=$(jq -r .domain "$site")
  systemd-run --wait --pipe --collect --uid=caddy --gid=caddy --setenv="NYLZO_DOMAIN=$NYLZO_DOMAIN" "$directory/caddy" validate --config /etc/caddy/Caddyfile >/dev/null
  if [[ "$previous" = v* && "$candidate" = release-* ]]; then
    built=$(systemd-run --wait --pipe --collect --uid=caddy --gid=caddy "$directory/caddy" version | cut -d ' ' -f 1)
    if [[ ! "$built" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || older "$built" "$previous"; then
      echo "Caddy downgrade refused: release $release builds Caddy $built, older than the installed $previous." >&2
      return 1
    fi
  fi
  if [[ -n "$previous" ]] && cmp --silent "$directory/caddy" "/opt/nylzo/caddy/$previous/caddy"; then restart=false; fi
  ln --symbolic --force --no-dereference --no-target-directory "$directory/caddy" /opt/nylzo/bin/caddy.next
  mv -T /opt/nylzo/bin/caddy.next /opt/nylzo/bin/caddy
  if [[ "$restart" = true ]] && { ! systemctl restart caddy.service || ! sleep 2 || ! systemctl is-active --quiet caddy.service; }; then
    if [[ -n "$previous" ]]; then
      ln --symbolic --force --no-dereference --no-target-directory "/opt/nylzo/caddy/$previous/caddy" /opt/nylzo/bin/caddy.previous
      mv -T /opt/nylzo/bin/caddy.previous /opt/nylzo/bin/caddy
      systemctl restart caddy.service
    fi
    return 1
  fi
  [[ "$restart" = true ]] || systemctl start caddy.service
  if [[ -n "$previous" ]]; then printf '%s\n' "$previous" > "$state/caddy.previous.tag"; fi
  printf '%s\n' "$candidate" > "$state/caddy.tag"
}
nylzo() {
  local version previous digest image
  version=$(jq -r .initialRelease "$site")
  if [[ -s "$state/current.json" ]]; then
    previous=$(jq -r .tag "$state/current.json")
    version=$(/opt/nylzo/runtime/release-target "$previous")
    [[ -n "$version" ]] || return 0
  fi
  download "https://api.github.com/repos/misaon/nylzo/releases/tags/$version" "$temporary/release.json"
  [[ "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || return 1
  jq -e --arg version "$version" '.tag_name == $version and .immutable == true and .draft == false and .prerelease == false' "$temporary/release.json" >/dev/null
  image=ghcr.io/misaon/nylzo
  cosign verify "$image:${version#v}" --certificate-identity "https://github.com/misaon/nylzo/.github/workflows/release.yml@refs/tags/$version" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com --output json > "$temporary/signature.json"
  digest=$(jq -er 'map(.critical.image["docker-manifest-digest"]) | unique | if length == 1 then .[0] else error("ambiguous image digest") end' "$temporary/signature.json")
  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  download "https://api.github.com/repos/misaon/nylzo/attestations/$digest" "$temporary/provenance.json"
  jq -ce '.attestations[].bundle' "$temporary/provenance.json" > "$temporary/provenance.jsonl"
  gh attestation verify "oci://$image@$digest" --bundle "$temporary/provenance.jsonl" --repo misaon/nylzo \
    --signer-workflow misaon/nylzo/.github/workflows/release.yml --source-ref "refs/tags/$version" --deny-self-hosted-runners >/dev/null
  if [[ -n "${previous:-}" ]]; then
    /opt/nylzo/runtime/refresh-tools "$version"
    host "$version"
  fi
  caddy "$version"
  docker pull "$image@$digest" >/dev/null
  mkdir "$temporary/data"
  chown 165532:165532 "$temporary/data"
  openssl rand -hex 32 > "$temporary/pepper"
  chown 165532:165532 "$temporary/pepper"
  chmod 0400 "$temporary/pepper"
  docker run --detach --name nylzo-probe --user 65532:65532 --network none \
    --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --memory 1g --cpus 1.5 --pids-limit 128 --ulimit memlock=1073741824:1073741824 --ulimit core=0:0 --env-file /etc/nylzo/service.env \
    --volume "$temporary/data:/home/nonroot:Z" \
    --volume "$temporary/pepper:/run/nylzo-pepper:ro,Z" "$image@$digest" serve >/dev/null
  local ready=false
  for ((attempt = 0; attempt < 30; attempt++)); do
    if docker exec nylzo-probe /ko-app/nylzo verify-client --server http://127.0.0.1:8080 >/dev/null 2>&1; then ready=true; break; fi
    sleep 2
  done
  [[ "$ready" = true ]] || return 1
  docker rm --force nylzo-probe >/dev/null
  systemctl stop nylzo.service
  [[ ! -s "$state/current.json" ]] || cp "$state/current.json" "$state/previous.json"
  jq -n --arg tag "$version" --arg digest "$digest" '{tag:$tag,digest:$digest}' > "$state/current.json.new"
  sync "$state/current.json.new"
  mv "$state/current.json.new" "$state/current.json"
  sync "$state"
  if ! systemctl start nylzo.service || ! /opt/nylzo/runtime/health; then
    systemctl stop nylzo.service
    cp "$state/current.json" "$state/failed.json"
    echo 'Candidate failed on persistent state; automatic database or binary rollback is refused.' >&2
    return 1
  fi
  echo "Installed verified Nylzo $version at $digest"
  /opt/nylzo/runtime/clean
}
case "${1:-}" in
  initialize)
    if [[ -s "$state/current.json" ]]; then
      systemctl start nylzo.service caddy.service
    else
      nylzo
    fi
    ;;
  caddy)
    [[ -s "$state/current.json" && "${2:-}" = "$(jq -r .tag "$state/current.json")" ]] || { echo 'Caddy comes only from the installed Nylzo release.' >&2; exit 1; }
    caddy "$2"
    ;;
  host)
    [[ -s "$state/current.json" && "${2:-}" = "$(jq -r .tag "$state/current.json")" ]] || { echo 'The host configuration comes only from the installed Nylzo release.' >&2; exit 1; }
    host "$2"
    ;;
  nylzo) nylzo ;;
  *) echo 'Usage: update initialize|check|caddy vX.Y.Z|host vX.Y.Z|nylzo' >&2; exit 2 ;;
esac
