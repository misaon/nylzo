#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
export PATH="/opt/nylzo/bin:$PATH"
umask 022
first_boot=false
if [[ "${1:-}" = --first-boot ]]; then
  first_boot=true
  shift
fi
library=/opt/nylzo/host
settings=/etc/nylzo/host.env
generation=${1:-}
fail() {
  echo "Host configuration refused: $1" >&2
  exit 1
}
setting() {
  sed -n "s/^$1=//p" "$settings"
}
[[ "$generation" =~ ^$library/(initial|release-v(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8}))$ && -d "$generation" && ! -L "$generation" ]] ||
  fail 'name a generation directory under /opt/nylzo/host'
[[ "$(head -n 1 "$generation/manifest")" = 'format 1' ]] || fail 'unknown bundle format'
[[ -z "$(find "$generation" ! -type d ! -type f -print -quit)" ]] || fail 'the bundle contains links or special files'
[[ -s "$settings" ]] || fail "create $settings first"
target_pattern='^/(opt/nylzo/runtime/[a-z-]+|etc/systemd/system/[a-z0-9@-]+\.(service|timer)|etc/systemd/system/[a-z0-9@-]+\.service\.d/[0-9a-z-]+\.conf|etc/ssh/sshd_config\.d/[0-9a-z-]+\.conf|etc/sysctl\.d/[0-9a-z-]+\.conf|etc/systemd/(journald|coredump)\.conf\.d/[0-9a-z-]+\.conf|etc/docker/daemon\.json|etc/containerd/[a-z]+\.toml|etc/flatcar/update\.conf)$'
targets() {
  tail -n +2 "$1" | while read -r target source; do
    [[ "$target" =~ $target_pattern ]] || fail "unexpected target $target"
    [[ "$source" =~ ^[a-z]+/[A-Za-z0-9.-]+$ ]] || fail "unexpected source $source"
    printf '%s %s\n' "$target" "$source"
  done
}
entries=$(targets "$generation/manifest")
while read -r target source; do
  [[ -f "$generation/$source" ]] || fail "missing $source"
done <<< "$entries"
changed=()
place() {
  local target=$1 file=$2 mode=644
  [[ "$target" != /opt/nylzo/runtime/* ]] || mode=755
  if [[ -f "$target" && ! -L "$target" && "$(stat -c %a "$target")" = "$mode" ]] && cmp --silent "$file" "$target"; then
    return
  fi
  mkdir -p "${target%/*}"
  install --mode="$mode" "$file" "$target.nylzo-new"
  mv -f "$target.nylzo-new" "$target"
  changed+=("$target")
}
composed=$(mktemp /run/nylzo-caddyfile.XXXXXXXX)
trap 'rm -f "$composed"' EXIT
cat "$generation/proxy/Caddyfile" > "$composed"
if [[ "$(setting WWW_REDIRECT)" = true ]]; then printf '\n' >> "$composed"; cat "$generation/proxy/www.Caddyfile" >> "$composed"; fi
if [[ -s /etc/nylzo/monitor-client.pem ]]; then printf '\n' >> "$composed"; cat "$generation/proxy/monitor.Caddyfile" >> "$composed"; fi
chmod 0644 "$composed"
domain=$(sed -n 's/^NYLZO_DOMAIN=//p' /etc/nylzo/caddy.env)
[[ "$domain" =~ ^[a-z0-9.-]{1,253}$ ]] || fail 'NYLZO_DOMAIN in /etc/nylzo/caddy.env is invalid'
if [[ "$first_boot" = false && -x /opt/nylzo/bin/caddy ]] && ! cmp --silent "$composed" /etc/caddy/Caddyfile; then
  systemd-run --wait --pipe --collect --quiet --uid=caddy --gid=caddy --setenv="NYLZO_DOMAIN=$domain" \
    /opt/nylzo/bin/caddy validate --config "$composed" >/dev/null || fail 'Caddy rejects the new Caddyfile'
fi
hardware_keys=/etc/ssh/sshd_config.d/10-nylzo-hardware-keys.conf
case "$(setting HARDWARE_KEYS_ONLY)" in
  true)
    hardware_only=true
    [[ -f "$generation/system/sshd-hardware-keys.conf" ]] || fail 'missing system/sshd-hardware-keys.conf'
    if ! cmp --silent "$generation/system/sshd-hardware-keys.conf" "$hardware_keys" &&
      ! grep --quiet --no-messages --extended-regexp '(^|[[:space:]])sk-ssh-ed25519@openssh\.com[[:space:]]' /home/core/.ssh/authorized_keys /home/core/.ssh/authorized_keys.d/*; then
      fail 'HARDWARE_KEYS_ONLY=true needs an authorized sk-ssh-ed25519@openssh.com key for core; add one, then run activate with sudo'
    fi
    ;;
  false | '') hardware_only=false ;;
  *) fail "set HARDWARE_KEYS_ONLY to true or false in $settings" ;;
esac
current=$(readlink -e "$library/current" 2>/dev/null || true)
if [[ -n "$current" && "$current" != "$generation" && -s "$current/manifest" ]]; then
  while read -r target _; do
    if ! grep --quiet --fixed-strings --line-regexp -- "$target" <<< "$(cut -d ' ' -f 1 <<< "$entries")"; then
      if [[ "$target" =~ ^/etc/systemd/system/[a-z0-9@-]+\.(service|timer)$ ]]; then systemctl disable --quiet --now "${target##*/}" || true; fi
      rm -f -- "$target"
    fi
  done < <(targets "$current/manifest")
fi
while read -r target source; do
  place "$target" "$generation/$source"
done <<< "$entries"
place /etc/caddy/Caddyfile "$composed"
if [[ "$hardware_only" = true ]]; then
  place "$hardware_keys" "$generation/system/sshd-hardware-keys.conf"
else
  rm -f -- "$hardware_keys"
fi
systemctl daemon-reload
enabled=()
while read -r action condition unit; do
  [[ "$unit" =~ ^[A-Za-z0-9@-]+\.(service|timer)$ ]] || fail "unexpected unit $unit"
  case "$condition" in
    always) wanted=true ;;
    automatic-updates) wanted=$(setting AUTOMATIC_UPDATES) ;;
    heartbeat) wanted=false; [[ ! -s /etc/nylzo/heartbeat.url ]] || wanted=true ;;
    *) fail "unknown condition $condition" ;;
  esac
  case "$action:$wanted" in
    enable:true)
      systemctl enable --quiet "$unit"
      enabled+=("$unit")
      if [[ "$first_boot" = false && "$unit" = *.timer ]]; then systemctl start "$unit"; fi
      ;;
    enable:false) systemctl disable --quiet --now "$unit" ;;
    mask:true) systemctl mask --quiet "$unit" ;;
    *) fail "unknown action $action" ;;
  esac
done < "$generation/units"
restart=()
for target in "${changed[@]}"; do
  case "$target" in
    /etc/sysctl.d/*) restart+=(systemd-sysctl.service) ;;
    /etc/systemd/journald.conf.d/*) restart+=(systemd-journald.service) ;;
    /etc/docker/* | /etc/containerd/* | /etc/systemd/system/containerd.service.d/*) restart+=(containerd.service docker.service) ;;
    /etc/flatcar/* | /etc/systemd/system/update-engine.service.d/*) restart+=(update-engine.service) ;;
    /etc/caddy/Caddyfile | /etc/systemd/system/caddy.service) restart+=(caddy.service) ;;
    /etc/systemd/system/*.timer) restart+=("${target##*/}") ;;
  esac
done
if ! systemctl restart nylzo-firewall.service; then
  systemctl status --no-pager --lines=20 nylzo-firewall.service >&2 || true
  fail 'the host firewall did not load'
fi
if [[ "$first_boot" = false && ${#restart[@]} -gt 0 ]]; then
  mapfile -t restart < <(printf '%s\n' "${restart[@]}" | sort --unique)
  systemctl try-restart "${restart[@]}"
fi
ln --symbolic --force --no-dereference --no-target-directory "$generation" "$library/current.next"
if [[ -n "$current" && "$current" != "$generation" ]]; then
  ln --symbolic --force --no-dereference --no-target-directory "$current" "$library/previous.next"
  mv --no-target-directory "$library/previous.next" "$library/previous"
fi
mv --no-target-directory "$library/current.next" "$library/current"
if [[ "$first_boot" = true ]]; then
  systemctl start --no-block "${enabled[@]}"
fi
echo "Activated host configuration ${generation##*/}"
