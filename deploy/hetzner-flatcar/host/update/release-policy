#!/usr/bin/env bash
set -euo pipefail
umask 077
export PATH="/opt/nylzo/bin:$PATH"
version="${1:-}"
[[ "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || exit 1
temporary=$(mktemp -d /var/tmp/nylzo-release-policy.XXXXXXXX)
trap 'rm -rf "$temporary"' EXIT
cd "$temporary"
manifest="nylzo_${version#v}.evidence.sha256"
filename="nylzo_${version#v}.release-policy.json"
base="https://github.com/misaon/nylzo/releases/download/$version"
for artifact in "$manifest" "$manifest.sigstore.json" "$filename"; do
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 --max-filesize 1048576 --retry 3 --max-time 90 "$base/$artifact" --output "$artifact"
done
cosign verify-blob "$manifest" --bundle "$manifest.sigstore.json" \
  --certificate-identity "https://github.com/misaon/nylzo/.github/workflows/release.yml@refs/tags/$version" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com >/dev/null
awk -v name="./$filename" '$2 == name { print; found++ } END { if (found != 1) exit 1 }' "$manifest" | sha256sum --check --strict >/dev/null
jq -e --arg tag "$version" '.format == 1 and .tag == $tag and .kind == "planned" and (.source | type == "string" and test("^[a-f0-9]{40}$")) and (.policyCommit | type == "string" and test("^[a-f0-9]{40}$"))' "$filename" >/dev/null
