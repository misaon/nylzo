#!/usr/bin/env bash
set -euo pipefail
umask 077
cd /var/tmp/nylzo-image
[[ "${EXPECTED_BUILDER_NAME:-}" =~ ^[a-z][a-z0-9-]{0,30}-image-builder$ ]] || exit 1
[[ "$(curl --fail --silent --max-time 3 http://169.254.169.254/hetzner/v1/metadata/hostname)" = "$EXPECTED_BUILDER_NAME" ]] || exit 1
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install --yes --no-install-recommends ca-certificates curl gnupg cpio kexec-tools
mkdir -p /var/tmp/nylzo-image/gnupg
chmod 0700 /var/tmp/nylzo-image/gnupg
gpg --batch --homedir /var/tmp/nylzo-image/gnupg --import flatcar.asc
# A signature is useful only with the independently reviewed Flatcar identity.
fingerprint=$(gpg --batch --homedir /var/tmp/nylzo-image/gnupg --with-colons --fingerprint --list-keys | awk -F: '$1 == "pub" { primary=1; next } primary && $1 == "fpr" { print $10; primary=0 }')
[[ "$fingerprint" = "F88CFEDEFF29A5B4D9523864E25D9AED0593B34A" ]] || { echo 'Unexpected Flatcar image signing key.' >&2; exit 1; }
base="https://stable.release.flatcar-linux.net/${FLATCAR_BOARD}/${FLATCAR_VERSION}"
for artifact in flatcar_production_pxe.vmlinuz flatcar_production_pxe_image.cpio.gz; do
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 --max-time 600 --max-filesize 1073741824 "$base/$artifact" --output "$artifact"
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 --max-time 60 --max-filesize 1048576 "$base/$artifact.sig" --output "$artifact.sig"
  gpg --batch --homedir /var/tmp/nylzo-image/gnupg --verify "$artifact.sig" "$artifact"
done
mkdir -p oem/usr/share/oem
key=$(gzip --no-name --stdout flatcar.asc | base64 --wrap=0)
sed "s|@@FLATCAR_IMAGE_KEY@@|data:;base64,$key|" installer.ign > oem/usr/share/oem/config.ign
(cd oem && find usr -print0 | cpio --null --create --format=newc --quiet) | gzip > oem.cpio.gz
cat flatcar_production_pxe_image.cpio.gz oem.cpio.gz > initrd
kexec --load flatcar_production_pxe.vmlinuz --initrd=initrd --command-line='flatcar.first_boot=1 console=tty0 console=ttyS0,115200n8'
systemctl kexec
