{
  "name": "@nylzo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/app/prerender.ts --outDir .prerender && node scripts/prerender.ts",
    "check": "node scripts/check-sources.ts",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p scripts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@nylzo/core": "workspace:*",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
