{
  "name": "@nylzo/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run --bun vite build && bun run --bun vite build --ssr src/app/prerender.ts --outDir .prerender && bun scripts/prerender.ts",
    "check": "bun scripts/check-sources.ts",
    "test": "bun run --bun vitest run",
    "typecheck": "bun run --bun svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings && bun ./node_modules/@typescript/native/bin/tsc -p scripts",
    "test:coverage": "bun run --bun vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@nylzo/core": "workspace:*",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.1.0",
    "acorn": "8.19.0",
    "browserslist": "4.29.5",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "lightningcss": "1.33.0",
    "parse5": "8.1.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
