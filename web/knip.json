{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@sveltejs/mcp"]
    },
    "app": {
      "entry": ["src/app/prerender.ts"],
      "ignoreDependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "@fontsource-variable/sora"
      ]
    },
    "e2e": {
      "playwright": {
        "config": ["playwright.config.ts", "playwright.monitor.config.ts"]
      }
    }
  }
}
