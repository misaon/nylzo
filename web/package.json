{
  "name": "nylzo-web",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "core",
    "app",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "lint": "oxfmt --check . && oxlint --deny-warnings --report-unused-disable-directives && knip",
    "lint:fix": "oxlint --fix && bun run format",
    "test": "bun run --parallel --filter @nylzo/core --filter @nylzo/web test",
    "typecheck": "bun run --parallel --filter \"*\" typecheck",
    "test:coverage": "bun run --parallel --filter @nylzo/core --filter @nylzo/web test:coverage"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@sveltejs/mcp": "0.1.30",
    "@types/bun": "1.4.4",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-regexp": "3.3.3",
    "knip": "6.45.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "overrides": {
    "eslint": "10.14.0",
    "minimatch": "11.0.7"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
  },
  "trustedDependencies": []
}
