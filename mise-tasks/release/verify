#!/usr/bin/env bash
#MISE description="Verify release signatures, rebuild the checked-out tag, and compare its published checksums and provenance"
#MISE depends=["install"]
set -euo pipefail

tag="$(git describe --exact-match --tags HEAD)"
[[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]
[[ -z "$(git status --porcelain)" ]]
version="${tag#v}"
verification="$(mktemp -d)"
trap 'rm -rf "$verification"' EXIT
gh release download "$tag" --repo misaon/nylzo --dir "$verification" \
  --pattern checksums.txt --pattern checksums.txt.sigstore.json --pattern "nylzo_${version}.intoto.jsonl"
cosign verify-blob "$verification/checksums.txt" --bundle "$verification/checksums.txt.sigstore.json" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com \
  --certificate-identity "https://github.com/misaon/nylzo/.github/workflows/release.yml@refs/tags/${tag}"
GORELEASER_CURRENT_TAG="$tag" goreleaser release --clean --skip=publish,sign,sbom,ko,validate
grep -v sbom "$verification/checksums.txt" > "$verification/published-without-sbom.txt"
grep -v sbom dist/checksums.txt | diff "$verification/published-without-sbom.txt" -
for artifact in dist/nylzo_*.tar.gz dist/nylzo_*.zip dist/nylzo-caddy_*.tar.gz ".host-bundle/nylzo-host_${version}.tar"; do
  gh attestation verify "$artifact" --repo misaon/nylzo --bundle "$verification/nylzo_${version}.intoto.jsonl" \
    --signer-workflow misaon/nylzo/.github/workflows/release.yml \
    --source-ref "refs/tags/${tag}" --deny-self-hosted-runners > /dev/null
done
printf '%s: the local build matches the signature-verified checksums.txt and the release provenance\n' "$tag"
shasum -a 256 "$verification/checksums.txt"
